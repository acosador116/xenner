# URL pública final, con https:// y sin slash final.
# Ejemplo: SITE_URL=https://xenner.example
# Sin esta variable la web funciona, pero se queda sin canonical, sin sitemap
# y sin la línea Sitemap de robots.txt. Es el ajuste más importante del despliegue.
SITE_URL=

# Token de verificación de Google Search Console. Si está vacío se usa el que
# ya viene en src/layouts/BaseLayout.astro. Se cambia aquí cuando se renueva la
# propiedad o se verifica otro dominio.
PUBLIC_GOOGLE_SITE_VERIFICATION=
