---
import Brand from './Brand.astro';

const sourceUrl = 'https://github.com/acosador116/xenner';
const specUrl = `${sourceUrl}/blob/main/xenner/docs/SKIN_SPEC.md`;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <Brand />
      <p>
        Editor de notas desktop con la interfaz en archivos de texto plano. Tus notas son
        archivos Markdown tuyos, en tu carpeta.
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Producto">
      <h2 class="site-footer__label">Producto</h2>
      <ul>
        <li><a href="#editor">El editor</a></li>
        <li><a href="#skins">Sistema de skins</a></li>
        <li><a href="#como-funciona">Cómo funciona</a></li>
        <li><a href="#faq">Preguntas</a></li>
      </ul>
    </nav>

    <nav class="site-footer__nav" aria-label="Recursos">
      <h2 class="site-footer__label">Recursos</h2>
      <ul>
        <li><a href={specUrl} target="_blank" rel="noreferrer">Especificación ↗</a></li>
        <li><a href={`${sourceUrl}#issues`} target="_blank" rel="noreferrer">Issues ↗</a></li>
        <li><a href={sourceUrl} target="_blank" rel="noreferrer">Código fuente ↗</a></li>
      </ul>
    </nav>
  </div>

  <div class="container site-footer__base">
    <p>MIT · {year}</p>
    <p>Hecho con Tauri, SolidJS, Rust y mucho texto plano.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-16);
    background: var(--bg-subtle);
    border-top: 1px solid var(--border);
  }

  .site-footer__inner {
    width: min(100% - var(--gutter) * 2, var(--container));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-10);
  }

  .site-footer__brand p {
    max-width: 24rem;
    margin-top: var(--space-3);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .site-footer__label {
    margin-bottom: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .site-footer__nav ul {
    display: grid;
    gap: var(--space-1);
    list-style: none;
  }

  .site-footer__nav a {
    display: block;
    padding: var(--space-1) 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: var(--accent-text);
    text-decoration: underline;
  }

  .site-footer__base {
    margin-top: var(--space-12);
    padding: var(--space-5) 0 var(--space-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .site-footer__base {
      margin-top: var(--space-8);
    }
  }
</style>
