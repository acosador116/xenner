---
import Brand from './Brand.astro';

const sourceUrl = 'https://github.com/acosador116/xenner';
const specUrl = `${sourceUrl}/blob/main/xenner/docs/SKIN_SPEC.md`;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <Brand />
      <p>Una ventana pequeña para ideas. Un archivo de texto para cambiar su mundo.</p>
    </div>

    <nav aria-label="Enlaces del pie">
      <span class="site-footer__label">directorios</span>
      <a href="#filosofia"><b>01</b> La idea</a>
      <a href="#skins"><b>02</b> Sistema de skins</a>
      <a href={specUrl} target="_blank" rel="noreferrer"><b>03</b> Especificación ↗</a>
      <a href={sourceUrl} target="_blank" rel="noreferrer"><b>04</b> Código fuente ↗</a>
    </nav>

    <div class="site-footer__drive" aria-label="Información del proyecto">
      <span class="site-footer__label">estado</span>
      <p>0.1 · MIT<br />{year} / Local</p>
      <a href="#inicio">↑ volver arriba</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--text);
    background: var(--bg-subtle);
    border-top: 1px solid var(--border);
  }

  .site-footer__inner {
    width: min(calc(100% - var(--gutter) - var(--gutter)), var(--container));
    margin: 0 auto;
    padding: 3.5rem 0 2rem;
    display: grid;
    grid-template-columns: 1.25fr 0.9fr 0.55fr;
    align-items: start;
    gap: 3rem;
  }

  .site-footer__brand p {
    max-width: 22rem;
    margin: 1rem 0 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  nav {
    display: grid;
  }

  .site-footer__label {
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  nav a {
    min-height: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  nav a:hover {
    color: var(--accent);
  }

  nav a b {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .site-footer__drive {
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .site-footer__drive p {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .site-footer__drive a {
    margin-top: 1rem;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .site-footer__drive a:hover {
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
