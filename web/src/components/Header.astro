---
import Brand from './Brand.astro';

const sourceUrl = 'https://github.com/acosador116/xenner';
const specUrl = `${sourceUrl}/blob/main/xenner/docs/SKIN_SPEC.md`;

const links = [
  { href: '#skins', label: 'Skins' },
  { href: '#editor', label: 'Editor' },
  { href: '#limites', label: 'Límites' },
  { href: '#faq', label: 'Preguntas' },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <Brand />

    <nav class="site-nav" aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__spec" href={specUrl} target="_blank" rel="noreferrer">
        Especificación
      </a>
      <a class="button button--primary site-header__cta" href={sourceUrl} target="_blank" rel="noreferrer">
        Ver el código
      </a>
    </div>

    <details class="site-header__mobile">
      <summary>
        <span class="visually-hidden">Abrir menú de navegación</span>
        <svg viewBox="0 0 20 20" aria-hidden="true" width="20" height="20">
          <path d="M3 6h14M3 10h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav aria-label="Navegación móvil">
        <ul>
          {links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
          <li><a href={specUrl} target="_blank" rel="noreferrer">Especificación ↗</a></li>
          <li><a href={sourceUrl} target="_blank" rel="noreferrer">Código fuente ↗</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Cierra el menú móvil al navegar, al pulsar Escape o al hacer clic fuera.
  // Sin esto, el panel tapa la sección a la que se acaba de saltar.
  const details = document.querySelector<HTMLDetailsElement>('.site-header__mobile');

  if (details) {
    const summary = details.querySelector('summary');

    details.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) details.open = false;
    });

    summary?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        details.open = false;
        summary.blur();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details.open) details.open = false;
    });

    document.addEventListener('click', (event) => {
      if (details.open && !details.contains(event.target as Node)) details.open = false;
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: saturate(180%) blur(12px);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .site-header {
      background: var(--bg);
    }
  }

  .site-header__inner {
    width: min(100% - var(--gutter) * 2, var(--container));
    min-height: var(--header-h);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .site-nav {
    margin-right: auto;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
  }

  .site-nav a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .site-nav a:hover {
    color: var(--text);
    background: var(--bg-muted);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__spec {
    /* min-height >=24px: WCAG 2.2 SC 2.5.8 (target size) */
    min-height: 2.5rem;
    padding: var(--space-2) var(--space-1);
    display: inline-flex;
    align-items: center;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .site-header__spec:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .site-header__cta {
    min-height: 2.25rem;
    padding-inline: var(--space-4);
    font-size: var(--text-sm);
  }

  /* ---------- móvil ---------- */

  .site-header__mobile {
    display: none;
    margin-left: auto;
  }

  .site-header__mobile summary {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-sm);
    color: var(--text);
    background: var(--surface);
    list-style: none;
    cursor: pointer;
  }

  .site-header__mobile summary::-webkit-details-marker {
    display: none;
  }

  .site-header__mobile nav {
    position: absolute;
    top: calc(var(--header-h) + 1px);
    right: var(--gutter);
    left: var(--gutter);
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }

  .site-header__mobile ul {
    display: grid;
    gap: 2px;
    list-style: none;
  }

  .site-header__mobile a {
    display: block;
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .site-header__mobile a:hover {
    background: var(--bg-muted);
  }

  @media (max-width: 860px) {
    .site-nav,
    .site-header__actions {
      display: none;
    }

    .site-header__mobile {
      display: block;
    }
  }
</style>
