---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SkinPlayground from '../components/SkinPlayground';
import BaseLayout from '../layouts/BaseLayout.astro';

const sourceUrl = 'https://github.com/acosador116/xenner';
const specUrl = `${sourceUrl}/blob/main/xenner/docs/SKIN_SPEC.md`;

const stack = [
  { name: 'Tauri 2', detail: 'ventana nativa' },
  { name: 'SolidJS', detail: 'reactividad fina' },
  { name: 'Rust', detail: 'backend y E/S' },
  { name: 'Milkdown', detail: 'editor visual' },
  { name: 'MIT', detail: 'código abierto' },
];

const files = [
  { name: 'background.txt', use: 'fondo de la ventana' },
  { name: 'toolbar.txt', use: 'barra superior' },
  { name: 'sidebar.txt', use: 'lista de notas' },
  { name: 'note.txt', use: 'tarjeta de nota' },
  { name: 'button.txt', use: 'botones' },
  { name: 'input.txt', use: 'campos y área de texto' },
];

const steps = [
  {
    n: '01',
    title: 'Elige una superficie',
    text: 'Cada parte de la ventana tiene su archivo. No toques un CSS gigante: edita solo el componente que quieres ver distinto.',
  },
  {
    n: '02',
    title: 'Cambia una clave',
    text: 'La sintaxis es una línea por variable, clave="valor". El parser rechaza llaves, punto y coma y !important.',
  },
  {
    n: '03',
    title: 'Recarga y sigue',
    text: 'El SkinEngine publica las claves como variables CSS. La ventana se rehace; tus notas no se enteran.',
  },
];

const editorFeatures = [
  {
    title: 'Biblioteca local de archivos',
    text: 'Explorador jerárquico con carpetas, páginas Markdown, arrastre para mover y menú contextual. El título de la nota es el nombre del archivo.',
  },
  {
    title: 'Editor visual Milkdown',
    text: 'Encabezados, listas, tareas, tablas, código, enlaces, imágenes y LaTeX, con autoguardado atómico y detección de cambios externos.',
  },
  {
    title: 'Pizarra y dibujos',
    text: 'Bloques de pizarra y trazos visuales que se guardan como SVG relativo dentro de tu propia carpeta.',
  },
  {
    title: 'Creador de skins integrado',
    text: 'Construye una skin desde la propia app, guárdala en tu biblioteca y cámbiala sin salir de la ventana.',
  },
];

const limits = [
  {
    title: 'Lectura acotada',
    text: 'El backend solo abre archivos conocidos y rechaza rutas que se salgan de la carpeta de skins.',
  },
  {
    title: 'Parser con límites',
    text: 'Se ignoran llaves, punto y coma, !important, url(...) y @import. Ninguna skin puede cargar recursos por red.',
  },
  {
    title: 'Fallback embebido',
    text: 'Toda clave ausente se resuelve contra la skin base del código. Una skin rota nunca deja la app sin escribir.',
  },
  {
    title: 'E/S acotada',
    text: 'Límites de 4 KiB en config.txt, 16 KiB en skin.txt y 64 KiB por componente, con 512 entradas y 256 skins en el scan.',
  },
];

const faqs = [
  {
    q: '¿Las notas viven en localStorage?',
    a: 'No. Xenner trabaja con una biblioteca local de archivos Markdown que tú eliges con el diálogo nativo. Tus notas son archivos tuyos, abribles con cualquier editor.',
  },
  {
    q: '¿Y si rompo una skin?',
    a: 'La ventana sigue funcionando. Toda clave que falte o se rechace se resuelve contra la skin base embebida en el código, que tiene una paleta clara y otra oscura.',
  },
  {
    q: '¿Puedo poner imágenes o scripts en una skin?',
    a: 'No en la v1. El parser rechaza url(...) y la CSP de Tauri bloquea orígenes remotos. Los assets de una nota se gestionan como archivos relativos, no como CSS de skin.',
  },
  {
    q: '¿Necesita cuenta o internet?',
    a: 'No hay cuentas, nube ni telemetría. La app abre tu carpeta local y funciona sin conexión.',
  },
  {
    q: '¿El cristal difumina el escritorio?',
    a: 'El backdrop-filter solo difumina el DOM de la página. Ver el escritorio a través de la ventana es lo que aporta "transparent": true; el blur nativo depende del compositor o de window-vibrancy en Windows y macOS.',
  },
];
---

<BaseLayout>
  <Header />

  <main id="contenido">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="container hero__inner">
        <p class="eyebrow">Editor de notas desktop · Tauri 2 + Rust</p>

        <h1 class="hero__title">
          Tu interfaz,<br />
          en archivos <em>de texto</em>.
        </h1>

        <p class="hero__lead">
          Xenner es un editor de notas de escritorio donde la ventana también se edita.
          Cambia el fondo, la barra lateral o los botones con archivos <strong>TXT</strong> planos,
          sin recompilar nada. Si una skin falla, la ventana sigue viva.
        </p>

        <div class="button-row hero__actions">
          <a class="button button--primary button--lg" href={sourceUrl} target="_blank" rel="noreferrer">
            Ver el código
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M6 3h7v7M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          </a>
          <a class="button button--lg" href="#skins">Probar el editor de skins</a>
        </div>

        <p class="hero__meta">
          Sin cuentas · Sin nube · Tus notas son archivos tuyos
        </p>
      </div>

      <div class="container">
        <div class="hero__stack" aria-label="Tecnologías del proyecto">
          {stack.map((item) => (
            <div class="hero__stack-item">
              <span class="hero__stack-name">{item.name}</span>
              <span class="hero__stack-detail">{item.detail}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ EDITOR ============ -->
    <section class="section section--tint" id="editor" aria-labelledby="editor-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">El producto</p>
          <h2 class="section-title" id="editor-title">Un editor de verdad,<br />no una maqueta.</h2>
          <p class="section-sub">
            Todo esto ya vive en el código: no es un roadmap. Xenner opera sobre una carpeta
            de archivos Markdown que tú controlas.
          </p>
        </div>

        <ul class="feature-grid">
          {editorFeatures.map((feature) => (
            <li class="feature">
              <h3 class="feature__title">{feature.title}</h3>
              <p class="feature__text">{feature.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ SKINS / PLAYGROUND ============ -->
    <section class="section" id="skins" aria-labelledby="skins-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">El sistema de skins</p>
          <h2 class="section-title" id="skins-title">Cambia una clave.<br /><em>Cambia la ventana.</em></h2>
          <p class="section-sub">
            Estos son los valores reales de las skins del repositorio. Mueve un campo y la vista
            previa se repinta: los componentes solo consumen variables CSS, nunca colores fijos.
          </p>
        </div>

        <SkinPlayground client:visible />

        <div class="file-list-wrap">
          <h3 class="file-list__title">Un archivo por superficie</h3>
          <ul class="file-list">
            {files.map((file) => (
              <li class="file-list__item">
                <code class="file-list__name">{file.name}</code>
                <span class="file-list__use">{file.use}</span>
              </li>
            ))}
          </ul>
          <p class="file-list__note">
            Una skin puede ser un único TXT: si falta <code>button.txt</code>, ese componente
            entero se resuelve contra la skin base.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ PASOS ============ -->
    <section class="section section--tint" id="como-funciona" aria-labelledby="steps-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Cómo funciona</p>
          <h2 class="section-title" id="steps-title">Tres pasos,<br />sin compilar.</h2>
        </div>

        <ol class="step-grid">
          {steps.map((step) => (
            <li class="step">
              <span class="step__n">{step.n}</span>
              <h3 class="step__title">{step.title}</h3>
              <p class="step__text">{step.text}</p>
            </li>
          ))}
        </ol>

        <figure class="code-figure">
          <figcaption class="code-figure__caption">
            <span>background.txt</span>
            <a class="arrow-link" href={specUrl} target="_blank" rel="noreferrer">
              Abrir SKIN_SPEC.md
            </a>
          </figcaption>
          <pre><code><span class="tok-comment"># una piel que sobrevivió al futuro</span>
<span class="tok-key">background</span>=<span class="tok-string">"#14161c"</span>
<span class="tok-key">text</span>=<span class="tok-string">"#e8eaf0"</span>
<span class="tok-key">accent</span>=<span class="tok-string">"#4ade80"</span>
<span class="tok-key">radius</span>=<span class="tok-string">"12px"</span>
<span class="tok-key">shadow</span>=<span class="tok-string">"0 8px 32px rgba(0,0,0,0.50)"</span>

<span class="tok-comment"># guardar. recargar. listo.</span></code></pre>
        </figure>
      </div>
    </section>

    <!-- ============ LÍMITES ============ -->
    <section class="section" id="limites" aria-labelledby="limits-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Confianza</p>
          <h2 class="section-title" id="limits-title">Libertad<br /><em>con cables.</em></h2>
          <p class="section-sub">
            Editar archivos a mano es un experimento con riesgos. Por eso el parser y el fallback
            tienen límites deliberados: una skin rota puede arruinar el experimento, nunca tu
            capacidad de escribir.
          </p>
        </div>

        <ul class="limit-grid">
          {limits.map((item, i) => (
            <li class="limit">
              <span class="limit__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="limit__title">{item.title}</h3>
              <p class="limit__text">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ NO INCLUIDO ============ -->
    <section class="section section--tint" aria-labelledby="scope-title">
      <div class="container container--narrow">
        <div class="section-head section-head--center">
          <p class="eyebrow">Alcance</p>
          <h2 class="section-title" id="scope-title">Lo que no<br />vas a encontrar.</h2>
          <p class="section-sub">
            Xenner es deliberadamente pequeño. Preferimos que las funciones existan en el código
            antes que prometerlas en una tabla.
          </p>
        </div>

        <ul class="scope-list">
          <li class="scope-item scope-item--no"><span aria-hidden="true">✕</span> Cuentas de usuario</li>
          <li class="scope-item scope-item--no"><span aria-hidden="true">✕</span> Sincronización en la nube</li>
          <li class="scope-item scope-item--no"><span aria-hidden="true">✕</span> Marketplace de plugins</li>
          <li class="scope-item scope-item--no"><span aria-hidden="true">✕</span> Teleetría o análisis</li>
          <li class="scope-item scope-item--yes"><span aria-hidden="true">✓</span> Archivos Markdown que tú eliges</li>
          <li class="scope-item scope-item--yes"><span aria-hidden="true">✓</span> Skins en TXT plano</li>
          <li class="scope-item scope-item--yes"><span aria-hidden="true">✓</span> Código abierto MIT</li>
        </ul>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="section" id="faq" aria-labelledby="faq-title">
      <div class="container container--narrow">
        <div class="section-head">
          <p class="eyebrow">Preguntas</p>
          <h2 class="section-title" id="faq-title">Lo que suelen<br />preguntar.</h2>
        </div>

        <div class="faq">
          {faqs.map((item, i) => (
            <details class="faq__item" open={i === 0}>
              <summary>
                <span>{item.q}</span>
                <svg class="faq__chevron" viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
                  <path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CTA FINAL ============ -->
    <section class="closing" aria-labelledby="closing-title">
      <div class="container container--narrow closing__inner">
        <h2 class="closing__title" id="closing-title">Abre un TXT.<br />Enciende todo.</h2>
        <p class="closing__sub">
          Lee el SkinEngine, cambia una clave y deja que Xenner se parezca a tu forma de pensar.
        </p>
        <div class="button-row closing__actions">
          <a class="button button--primary button--lg" href={sourceUrl} target="_blank" rel="noreferrer">
            Abrir en GitHub
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M6 3h7v7M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          </a>
          <a class="button button--lg" href={specUrl} target="_blank" rel="noreferrer">
            Leer la especificación
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ============ HERO ============ */

  .hero {
    padding: clamp(3.5rem, 8vw, 6rem) 0 var(--space-16);
  }

  /* Centrado: sin una visual en el hero, alinear a la izquierda dejaba
     media pantalla vacía a la derecha y desequilibraba la página. */
  .hero__inner {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
    display: grid;
    justify-items: center;
  }

  .hero__inner .eyebrow {
    justify-content: center;
  }

  .hero__title {
    margin-top: var(--space-4);
    font-size: clamp(2.5rem, 6.5vw, var(--text-3xl));
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .hero__title em {
    color: var(--accent-text);
    font-style: normal;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: var(--space-5);
    color: var(--text-secondary);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    text-wrap: balance;
  }

  .hero__lead strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero__actions {
    margin-top: var(--space-8);
    justify-content: center;
  }

  .hero__meta {
    margin-top: var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* franja de stack */

  /* Bordes por celda (no por hueco): con 5 elementos y 2 columnas la última
     celda quedaría vacía y se vería el color del contenedor. */
  .hero__stack {
    margin-top: var(--space-16);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    overflow: hidden;
  }

  .hero__stack-item {
    padding: var(--space-4);
    display: grid;
    gap: 2px;
  }

  .hero__stack-item + .hero__stack-item {
    border-left: 1px solid var(--border);
  }

  .hero__stack-name {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .hero__stack-detail {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  /* ============ CABECERA DE SECCIÓN ============ */

  .section-head {
    max-width: 40rem;
    display: grid;
    gap: var(--space-3);
  }

  .section-head--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .section-title {
    font-size: clamp(1.875rem, 4vw, var(--text-2xl));
  }

  .section-title em {
    color: var(--accent-text);
    font-style: normal;
  }

  .section-sub {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  /* ============ FEATURES ============ */

  .feature-grid {
    margin-top: var(--space-12);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    list-style: none;
  }

  .feature {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .feature__title {
    font-size: var(--text-md);
    font-weight: 600;
  }

  .feature__text {
    margin-top: var(--space-2);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  /* ============ PLAYGROUND ============ */

  :global(.pg) {
    margin-top: var(--space-12);
  }

  /* ============ LISTA DE ARCHIVOS ============ */

  .file-list-wrap {
    margin-top: var(--space-16);
  }

  .file-list__title {
    font-size: var(--text-md);
    font-weight: 600;
  }

  .file-list {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    list-style: none;
  }

  .file-list__item {
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  .file-list__name {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--accent-text);
  }

  .file-list__use {
    color: var(--text-muted);
    font-size: var(--text-xs);
    text-align: right;
  }

  .file-list__note {
    margin-top: var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .file-list__note code {
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  /* ============ PASOS ============ */

  .step-grid {
    margin-top: var(--space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    list-style: none;
  }

  .step {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .step__n {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-text);
  }

  .step__title {
    font-size: var(--text-md);
    font-weight: 600;
  }

  .step__text {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  /* ============ FIGURA DE CÓDIGO ============ */

  .code-figure {
    margin: var(--space-16) 0 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  .code-figure__caption {
    padding: var(--space-3) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .code-figure__caption > span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .code-figure pre {
    margin: 0;
    padding: var(--space-5);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.85;
  }

  .tok-comment { color: var(--code-comment); }
  .tok-key { color: var(--code-key); }
  .tok-string { color: var(--code-string); }

  /* ============ LÍMITES ============ */

  .limit-grid {
    margin-top: var(--space-12);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--border);
    overflow: hidden;
    list-style: none;
  }

  .limit {
    padding: var(--space-6);
    display: grid;
    gap: var(--space-2);
    background: var(--surface);
  }

  .limit__n {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
  }

  .limit__title {
    font-size: var(--text-md);
    font-weight: 600;
  }

  .limit__text {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  /* ============ ALCANCE ============ */

  .scope-list {
    margin-top: var(--space-10);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2) var(--space-6);
    list-style: none;
  }

  .scope-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  .scope-item span {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
  }

  .scope-item--no {
    color: var(--text-muted);
  }

  .scope-item--no span {
    color: var(--text-secondary);
    background: var(--bg-muted);
  }

  .scope-item--yes {
    color: var(--text);
    font-weight: 500;
  }

  .scope-item--yes span {
    color: var(--on-accent);
    background: var(--accent);
  }

  /* ============ FAQ ============ */

  .faq {
    margin-top: var(--space-10);
    border-top: 1px solid var(--border);
  }

  .faq__item {
    border-bottom: 1px solid var(--border);
  }

  .faq__item summary {
    padding: var(--space-5) 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: var(--text-base);
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover {
    color: var(--accent-text);
  }

  .faq__chevron {
    flex: none;
