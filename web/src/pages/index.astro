---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProductDemo from '../components/ProductDemo';
import BaseLayout from '../layouts/BaseLayout.astro';

const sourceUrl = 'https://github.com/acosador116/xenner';
const specUrl = `${sourceUrl}/blob/main/xenner/docs/SKIN_SPEC.md`;

const principles = [
  {
    number: '01',
    title: 'Elige una superficie',
    text: 'Toolbar, sidebar, botones, input, nota o fondo. Cada parte de la ventana tiene su propio archivo.',
    code: 'skins/mi_piel/background.txt',
  },
  {
    number: '02',
    title: 'Cambia una clave',
    text: 'La sintaxis es lo bastante simple para editarla con calma: clave="valor". Nada de perseguir clases CSS.',
    code: 'accent="#2563eb"',
  },
  {
    number: '03',
    title: 'Recarga y sigue',
    text: 'Xenner reconstruye la apariencia. Tus notas no forman parte del experimento visual.',
    code: 'status=ready',
  },
];

const safeguards = [
  {
    label: 'Lectura acotada',
    text: 'El backend solo abre archivos conocidos y rechaza rutas fuera de la carpeta de skins.',
  },
  {
    label: 'CSS con límites',
    text: 'El parser rechaza llaves, punto y coma y !important antes de convertir claves en variables CSS.',
  },
  {
    label: 'Fallback siempre',
    text: 'Si una skin falta o se rompe, la skin embebida mantiene la ventana en marcha.',
  },
  {
    label: 'Datos locales',
    text: 'La versión actual guarda las notas en localStorage dentro de la app. No envía ese contenido a un servidor.',
  },
];

const buildCards = [
  {
    type: 'wide',
    kicker: 'App real',
    title: 'Notas de verdad, no maquetas.',
    text: 'Crear, editar, seleccionar y borrar notas en una ventana de escritorio construida con Tauri, SolidJS, TypeScript y Rust.',
    visual: 'notes',
  },
  {
    type: 'normal',
    kicker: 'Skin engine',
    title: 'La piel se puede abrir.',
    text: 'Frosted Glass y WebCore existen como ejemplos reales, con skins por componente y fallback embebido.',
    visual: 'skins',
  },
  {
    type: 'normal',
    kicker: 'Ventana nativa',
    title: 'La ventana se mezcla con el escritorio.',
    text: 'La transparencia nativa de Tauri deja ver el fondo detrás de la interfaz. El blur del sistema depende de la plataforma.',
    visual: 'window',
  },
  {
    type: 'wide dark',
    kicker: 'No incluido',
    title: 'El foco sigue siendo pequeño.',
    text: 'No hay cuentas, nube, marketplace ni catálogo de plugins. La identidad nace del escritorio, las notas y los archivos TXT.',
    visual: 'none',
  },
];
---

<BaseLayout>
  <Header />

  <main id="contenido">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="container hero__inner">
        <div class="hero__copy">
          <p class="eyebrow">Notas de escritorio / v0.1</p>
          <h1 id="hero-title">
            Un TXT.<br />
            <span>Otra</span> interfaz.<br />
            <em>0 filas de código.</em>
          </h1>
          <p class="hero__lead">
            Xenner es un editor de notas donde la ventana también se edita. Cambia el fondo,
            la toolbar o los botones con archivos <strong>TXT claros</strong>. Si una skin falla,
            otra mantiene vivo el escritorio.
          </p>

          <div class="button-row">
            <a class="button button--primary" href="#skins">
              Tocar el sistema
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
            <a class="button button--secondary" href={sourceUrl} target="_blank" rel="noreferrer">
              Ver el código
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M6 3h7v7M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
            </a>
          </div>
        </div>

        <section class="hero__product" id="producto" aria-labelledby="demo-title">
          <h2 class="visually-hidden" id="demo-title">Vista previa interactiva de Xenner</h2>
          <ProductDemo client:visible />
        </section>
      </div>
    </section>

    <section class="manual" id="filosofia" aria-labelledby="manual-title">
      <div class="container">
        <div class="manual__heading">
          <div>
            <p class="eyebrow">Manual rápido</p>
            <h2 id="manual-title">Una skin empieza<br />en un <em>archivo.</em></h2>
          </div>
          <div class="manual__intro">
            <p>
              No es una paleta encerrada en un desplegable. Es una carpeta con archivos pequeños,
              legibles y-RV para que cualquiera pueda abrir la capucha y tocar la pintura.
            </p>
          </div>
        </div>

        <div class="principle-grid">
          {principles.map((principle) => (
            <article class="principle-card">
              <div class="principle-card__top">
                <span>{principle.number}</span>
              </div>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
              <code>{principle.code}</code>
            </article>
          ))}
        </div>

        <div class="file-window">
          <div class="file-window__copy">
            <span class="file-window__label">Ejemplo real / background.txt</span>
            <h3>Una línea.<br />Otro mundo.</h3>
            <p>
              El parser entiende comentarios y pares de clave/valor. La skin gana donde existe;
              el default embebido cubre lo que falta.
            </p>
            <a href={specUrl} target="_blank" rel="noreferrer">Abrir SKIN_SPEC.md ↗</a>
          </div>

          <div class="code-card" aria-label="Ejemplo de configuración de skin">
            <div class="code-card__titlebar">
              <div class="code-card__lights" aria-hidden="true"><i></i><i></i><i></i></div>
              <span>background.txt</span>
            </div>
            <pre><code><span class="code-comment"># configuración de la skin</span>
<span class="code-key">background</span>=<span class="code-value">"#ffffff"</span>
<span class="code-key">blur</span>=<span class="code-value">"0px"</span>
<span class="code-key">text</span>=<span class="code-value">"#171717"</span>
<span class="code-key">accent</span>=<span class="code-value">"#2563eb"</span>

<span class="code-comment"># guardar. recargar. listo.</span></code></pre>
          </div>
        </div>
      </div>
    </section>

    <section class="system" id="skins" aria-labelledby="system-title">
      <div class="container">
        <div class="system__heading">
          <div>
            <p class="eyebrow">Libertad con cables</p>
            <h2 id="system-title">Cambia todo.<br /><em>Rompe menos.</em></h2>
          </div>
          <div class="system__scope">
            <p>
              Una skin rota puede arruinar el experimento, pero no debería dejarte sin escribir.
              Por eso la lectura, el parser y el fallback tienen límites visibles.
            </p>
          </div>
        </div>

        <div class="safeguard-grid">
          {safeguards.map((item, index) => (
            <article class="safeguard-card">
              <div class="safeguard-card__top">
                <span>Regla {String(index + 1).padStart(2, '0')}</span>
              </div>
              <h3>{item.label}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>

        <div class="fallback-line">
          <strong class="fallback-line__label">Fallback</strong>
          <p><strong>Principio de continuidad:</strong> si una skin se rompe, xenner vuelve al default embebido.</p>
          <a href={specUrl} target="_blank" rel="noreferrer">Leer spec ↗</a>
        </div>
      </div>
    </section>

    <section class="build" id="construccion" aria-labelledby="build-title">
      <div class="container">
        <div class="build__heading">
          <div>
            <p class="eyebrow">Contenido / Producto real</p>
            <h2 id="build-title">Esto no es<br />un <em>roadmap fantasma.</em></h2>
          </div>
          <div class="build__manifest">
            <p>
              La web enseña lo que ya vive en el código. Las funciones que todavía no existen
              se quedan fuera de las promesas.
            </p>
          </div>
        </div>

        <div class="build__grid">
          {buildCards.map((card) => (
            <article class:list={['build-card', `build-card--${card.type.replace(' ', '-')}`]}>
              <div class="build-card__top">
                <span>{card.kicker}</span>
              </div>

              <div class="build-card__body">
                <h3>{card.title}</h3>
                <p>{card.text}</p>

                {card.visual === 'notes' && (
                  <div class="build-card__notes" aria-hidden="true">
                    <div class="build-card__note-sidebar">
                      <span>03 notas</span>
                      <i class="active"></i><i></i><i></i>
                    </div>
                    <div class="build-card__note-page">
                      <b>Una idea<br />más</b>
                      <span></span><span></span><span></span><span></span>
                    </div>
                  </div>
                )}

                {card.visual === 'skins' && (
                  <div class="build-card__swatches" aria-label="Colores de las skins de ejemplo">
                    <i></i><i></i><i></i><i></i>
                    <span>Frosted / WebCore</span>
                  </div>
                )}

                {card.visual === 'window' && (
                  <div class="build-card__native-window" aria-hidden="true">
                    <div><i></i><i></i><i></i><span>xenner — ventana</span></div>
                    <p>Tauri / Nativa / 01</p>
                  </div>
                )}

                {card.visual === 'none' && (
                  <div class="build-card__none" aria-hidden="true">
                    <span>No</span><i></i><i></i><i></i>
                    <b>cuentas ✕ &nbsp; nube ✕ &nbsp; plugins ✕</b>
                  </div>
                )}
              </div>

              {card.visual === 'none' && (
                <div class="build-card__footer">
                  <span>Fuente pública</span>
                  <a href={sourceUrl} target="_blank" rel="noreferrer">Comprobar en el repo ↗</a>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="container closing__inner">
        <p class="eyebrow">Próximo comando</p>
        <h2 id="closing-title">Abre un TXT.<br /><em>Enciende todo.</em></h2>
        <p>Lee el SkinEngine, cambia una clave y deja que xenner se parezca a tu forma de pensar.</p>
        <div class="button-row">
          <a class="button button--primary" href={sourceUrl} target="_blank" rel="noreferrer">
            Abrir xenner en GitHub
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3h7v7M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
          </a>
          <a class="button button--secondary" href="#inicio">Volver al inicio ↑</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: clamp(8rem, 15vh, 12rem) 0 clamp(4rem, 8vw, 6rem);
    background: var(--bg);
  }

  .hero__inner {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .hero__copy {
    max-width: 42rem;
  }

  .hero .eyebrow {
    color: var(--accent);
  }

  .hero h1 {
    margin: 1.25rem 0 0;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero h1 span {
    color: var(--accent);
  }

  .hero h1 em {
    color: var(--text);
    font-style: normal;
  }

  .hero__lead {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .hero__lead strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero .button-row {
    margin-top: 2rem;
  }

  .hero__product {
    width: 100%;
  }

  .manual {
    padding: clamp(5rem, 10vw, 8rem) 0;
    background: var(--bg-subtle);
    border-top: 1px solid var(--border);
  }

  .manual__heading,
  .system__heading,
  .build__heading {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .manual h2,
  .system h2,
  .build h2,
  .closing h2 {
    margin: 1rem 0 0;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .manual h2 em,
  .system h2 em,
  .build h2 em,
  .closing h2 em {
    color: var(--accent);
    font-style: normal;
  }

  .manual__intro p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .principle-grid {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .principle-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .principle-card__top {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .principle-card h3 {
    margin: 1.25rem 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .principle-card p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .principle-card code {
    margin-top: 1.25rem;
    padding: 0.625rem 0.75rem;
    overflow: hidden;
    color: var(--text-secondary);
    border-radius: 6px;
    background: var(--bg-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-window {
    margin-top: clamp(4rem, 8vw, 6rem);
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .file-window__label {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .file-window__copy h3 {
    margin: 0.75rem 0;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .file-window__copy p {
    max-width: 28rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .file-window__copy a {
    margin-top: 1.25rem;
    display: inline-block;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .file-window__copy a:hover {
    text-decoration: underline;
  }

  .code-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-mono);
  }

  .code-card__titlebar {
    padding: 0.625rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .code-card__lights {
    display: flex;
    gap: 0.375rem;
  }

  .code-card__lights i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .code-card__lights i:nth-child(1) { background: #ef4444; }
  .code-card__lights i:nth-child(2) { background: #f59e0b; }
  .code-card__lights i:nth-child(3) { background: #22c55e; }

  .code-card pre {
    margin: 0;
    padding: 1.5rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.8;
  }

  .code-comment { color: var(--text-muted); }
  .code-key { color: var(--accent); }
  .code-value { color: var(--text); }

  .system {
    padding: clamp(5rem, 10vw, 8rem) 0;
    background: var(--bg);
  }

  .system .eyebrow {
    color: var(--accent);
  }

  .system__scope p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .safeguard-grid {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .safeguard-card {
    padding: 1.5rem;
  }

  .safeguard-card:nth-child(even) {
    border-left: 1px solid var(--border);
  }

  .safeguard-card:nth-child(n+3) {
    border-top: 1px solid var(--border);
  }

  .safeguard-card__top {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .safeguard-card h3 {
    margin: 1rem 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .safeguard-card p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .fallback-line {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--accent-subtle);
    font-size: 0.875rem;
  }

  .fallback-line__label {
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .fallback-line p {
    margin: 0;
    color: var(--text-secondary);
  }

  .fallback-line a {
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .fallback-line a:hover {
    text-decoration: underline;
  }

  .build {
    padding: clamp(5rem, 10vw, 8rem) 0;
    background: var(--bg-subtle);
    border-top: 1px solid var(--border);
  }

  .build .eyebrow {
    color: var(--accent);
  }

  .build__manifest p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .build__grid {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .build-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .build-card--wide {
    grid-column: span 2;
  }

  .build-card--dark {
    color: #fff;
    background: #171717;
    border-color: #171717;
  }

  .build-card__top {
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .build-card--dark .build-card__top {
    color: rgba(255,255,255,0.5);
    border-bottom-color: rgba(255,255,255,0.1);
  }

  .build-card__body {
    flex: 1;
    padding: 1.5rem;
  }

  .build-card--wide .build-card__body {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    column-gap: 2.5rem;
    align-items: start;
  }

  .build-card h3 {
    max-width: 16ch;
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .build-card p {
    max-width: 36rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .build-card--dark p {
    color: rgba(255,255,255,0.6);
  }

  .build-card__notes {
    min-height: 14rem;
    display: grid;
    grid-template-columns: 32% 1fr;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .build-card__note-sidebar {
    padding: 0.75rem;
    border-right: 1px solid var(--border);
    background: var(--bg-muted);
  }

  .build-card__note-sidebar span {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .build-card__note-sidebar i {
    height: 1.75rem;
    margin-bottom: 0.375rem;
    display: block;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    background: var(--surface);
  }

  .build-card__note-sidebar i.active {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .build-card__note-page {
    padding: 1.25rem;
  }

  .build-card__note-page b {
    display: block;
    margin-bottom: 1.25rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .build-card__note-page span {
    height: 0.375rem;
    margin-top: 0.5rem;
    display: block;
    border-radius: 2px;
    background: var(--border);
  }

  .build-card__note-page span:nth-child(3) { width: 84%; }
  .build-card__note-page span:nth-child(4) { width: 93%; }
  .build-card__note-page span:nth-child(5) { width: 62%; }

  .build-card__swatches {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
