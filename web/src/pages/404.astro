---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="Esta página no existe." noindex>
  <main class="nf" id="contenido">
    <div class="shell nf__inner">
      <p class="label">Error 404</p>
      <h1 class="nf__title">Esta nota<br />no está aquí.</h1>
      <p class="nf__lead">
        La dirección no existe. Quizá la moviste de sitio, o el enlace tenía un error.
      </p>
      <div class="nf__cta">
        <a class="cta cta--fill" href="/">Volver al inicio</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .nf {
    min-height: 74vh;
    padding: var(--air) 0;
    display: grid;
    align-content: center;
  }

  .nf__inner {
    max-width: 30rem;
    display: grid;
    gap: 0.9rem;
  }

  .nf__title {
    font-family: var(--serif);
    font-size: clamp(2.25rem, 5.4vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .nf__lead {
    color: var(--ink-2);
    font-size: var(--t-md);
  }

  .nf__cta {
    margin-top: 0.6rem;
  }
</style>
